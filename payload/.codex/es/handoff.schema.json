{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 3,
      "maximum": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "not_found",
        "blocked"
      ],
      "description": "ready: primary evidence and no unresolved questions. partial: primary evidence plus unresolved questions. not_found: empty primary/related and explain the missing evidence in unresolved. blocked: empty primary/related and explain the obstacle in unresolved."
    },
    "primary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "description": "Inclusive end line, at least start."
          },
          "symbol": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "Explain why this location answers the question. Do not repeat source text; the host attaches the original lines."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "encoding": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "start",
          "end",
          "symbol",
          "evidence",
          "sha256",
          "encoding"
        ],
        "additionalProperties": false
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "description": "Inclusive end line, at least start."
          },
          "symbol": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "Explain why this location answers the question. Do not repeat source text; the host attaches the original lines."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "encoding": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "start",
          "end",
          "symbol",
          "evidence",
          "sha256",
          "encoding"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "status",
    "primary",
    "related",
    "unresolved"
  ],
  "additionalProperties": false,
  "description": "Source evidence report. Cite the smallest ranges needed using the supplied source paths and 1-based inclusive lines. Keep explanations concise; overlapping citations are allowed when they support different findings."
}
