{
  "mcpServers": {
    "explore-solve": {
      "command": "uv",
      "args": ["run", "--script", "payload/.codex/es/server.py"],
      "cwd": ".",
      "omit_tools_from": ["code_mode"],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 3600
    },
    "agy-subagents": {
      "command": "uv",
      "args": ["run", "--script", "payload/.codex/es/subagents.py"],
      "cwd": ".",
      "omit_tools_from": ["code_mode"],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 3600
    }
  }
}
